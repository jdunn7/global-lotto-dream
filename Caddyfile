# Lotto Global — Caddy Configuration
# Replace :80 with your domain when DNS is ready, e.g.:
# lottoglobal.com, www.lottoglobal.com {

:80 {
	root * /var/www/lottoglobal
	file_server
	try_files {path} {path}.html

	# Gzip + Brotli compression
	encode gzip zstd

	# Cache static assets aggressively
	header /c/* Cache-Control "public, max-age=31536000, immutable"
	header /p/* Cache-Control "public, max-age=31536000, immutable"
	header /v/* Cache-Control "public, max-age=31536000, immutable"
	header /uploads/* Cache-Control "public, max-age=31536000, immutable"
	header *.css Cache-Control "public, max-age=86400"
	header *.js Cache-Control "public, max-age=86400"
	header *.png Cache-Control "public, max-age=604800"

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Redirect / to Lotto Global.html
	@root path /
	redir @root /Lotto%20Global.html
}

# When you have a domain, uncomment and use this block instead:
# lottoglobal.com, www.lottoglobal.com {
